<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration, slug "inner": signing request 1 of 2 in .github/workflows/release.yml.
     The artifact is installer\target\inner\ from "build-installer.cmd inner" (zipped by actions/upload-artifact).
     uninstall.exe is a copy of the bare installer exe (SemSearch-Setup.exe); it goes into the payload.
     version: "version" of shell/tauri.conf.json, passed by the workflow.
     SignPath Foundation: every signed file must have product name = the project's name and the same product version,
     checked here. Not met yet: bin\semsearch-engine.exe has no version resource and the installer exe (so
     uninstall.exe) says "SemSearch Setup"; until they are fixed, this configuration rejects those files. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="SemSearch.exe" product-name="SemSearch" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="bin/semsearch-engine.exe" product-name="SemSearch" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="uninstall.exe" product-name="SemSearch" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
